#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

origin_url=$(git config --get remote.origin.url || true)
pinned_origin=$(git config --local --get axilio.identityPolicyOrigin || true)
if [ -z "$origin_url" ] || [ "$origin_url" != "$pinned_origin" ]; then
  echo "identity policy origin changed; rerun scripts/install-git-hooks.sh" >&2
  exit 1
fi

if ! tracking_oid=$(git rev-parse --verify refs/remotes/origin/main 2>/dev/null); then
  echo "origin/main is missing; fetch origin and rerun scripts/install-git-hooks.sh" >&2
  exit 1
fi
if ! remote_record=$(git ls-remote --exit-code origin refs/heads/main); then
  echo "origin/main could not be verified against the live remote" >&2
  exit 1
fi
remote_oid=${remote_record%%[[:space:]]*}
if [ "$tracking_oid" != "$remote_oid" ]; then
  echo "origin/main is stale; fetch origin and rerun scripts/install-git-hooks.sh" >&2
  exit 1
fi

hook_tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/git-identity-push.XXXXXX")
trap 'rm -rf "$hook_tmp_dir"' EXIT
policy_file="$hook_tmp_dir/policy.txt"
git show "refs/remotes/origin/main:.github/git-identity-allowlist.txt" > "$policy_file"

configured_email=$(git config --get user.email || true)
if [ -z "$configured_email" ]; then
  echo "repository Git user.email is missing; set an approved repository-local identity" >&2
  exit 1
fi
.github/scripts/check-git-identities.sh \
  --policy "$policy_file" \
  --active-email "$configured_email"

zero_oid=0000000000000000000000000000000000000000
queued_ref_count=0
while read -r local_ref local_oid _remote_ref _remote_oid; do
  [ -n "${local_ref:-}" ] || continue
  if [ "$local_oid" = "$zero_oid" ]; then
    continue
  fi
  case "$local_ref" in
    refs/heads/*|refs/tags/*) ;;
    *)
      echo "identity policy rejected object $local_oid field ref-type" >&2
      exit 1
      ;;
  esac
  .github/scripts/check-git-identities.sh \
    --policy "$policy_file" \
    --rev "$local_oid"
  queued_ref_count=$((queued_ref_count + 1))
done

echo "identity pre-push gate passed for $queued_ref_count non-deletion refs"
